{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yijie.ai/web-retrieval/v1",
  "$defs": {
    "PublicUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "uri",
      "pattern": "^https?://",
      "description": "Public HTTP(S) URL. Connector additionally parses authority, rejects userinfo/control characters and local/private literal destinations; no local request to this target is made."
    },
    "SearchArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "include_content": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "FetchArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/PublicUrl"
        }
      }
    },
    "SearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "snippet"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 65536
        },
        "url": {
          "$ref": "#/$defs/PublicUrl"
        },
        "snippet": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "SearchSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "truncated"
      ],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/SearchResult"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "FetchSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "markdown",
        "truncated"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/PublicUrl"
        },
        "title": {
          "type": "string",
          "maxLength": 65536
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_arguments",
        "authentication_failed",
        "permission_denied",
        "rate_limited",
        "timeout",
        "unavailable",
        "no_content",
        "response_too_large",
        "invalid_response",
        "cancelled"
      ]
    },
    "ToolError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "invalid_arguments"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "检索参数无效，请检查查询词、数量或网页地址。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "authentication_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Kimi API Key 无效或已失效，请重新配置。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "permission_denied"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "服务拒绝了此请求，请检查账户权限或目标网页是否允许读取。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "rate_limited"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Kimi 请求频率或并发受限，请确认后重新发起调用。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "timeout"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "本次网页检索超时，未自动重试；已发送的请求可能计费。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "网页检索服务暂不可用，未自动重试。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "no_content"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "目标网页未返回可读取的正文。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "response_too_large"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "网页检索结果超过可处理的大小限制。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invalid_response"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "网页检索服务返回了无法验证的结果。"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "cancelled"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "本次网页检索已取消；已发送的请求可能计费。"
              }
            },
            "required": [
              "message"
            ]
          }
        }
      ]
    },
    "ErrorOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/ToolError"
        }
      }
    },
    "SearchOutput": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/SearchSuccess"
        },
        {
          "$ref": "#/$defs/ContentSuccess"
        },
        {
          "$ref": "#/$defs/ErrorOutput"
        }
      ]
    },
    "FetchOutput": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/FetchSuccess"
        },
        {
          "$ref": "#/$defs/ErrorOutput"
        }
      ]
    },
    "ContentStatus": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "truncated"
      ]
    },
    "ChunkScore": {
      "type": "number",
      "description": "Finite query-relative score. No cross-query trust threshold."
    },
    "SearchChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "score"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "score": {
          "$ref": "#/$defs/ChunkScore"
        }
      }
    },
    "DateBound": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!0000)[0-9]{4}$"
        },
        {
          "type": "string",
          "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ]
    },
    "TimeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "start": {
          "$ref": "#/$defs/DateBound"
        },
        "end": {
          "$ref": "#/$defs/DateBound"
        }
      }
    },
    "ProArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "sites": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\s()]+$"
          }
        },
        "time_window": {
          "$ref": "#/$defs/TimeWindow"
        }
      }
    },
    "ContentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "snippet",
        "text",
        "content_status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 65536
        },
        "url": {
          "$ref": "#/$defs/PublicUrl"
        },
        "snippet": {
          "type": "string",
          "maxLength": 65536
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "content_status": {
          "$ref": "#/$defs/ContentStatus"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content_status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "not": {
              "properties": {
                "text": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      ]
    },
    "ProResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "snippet",
        "site_name",
        "date",
        "authority",
        "chunks",
        "content_status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 65536
        },
        "url": {
          "$ref": "#/$defs/PublicUrl"
        },
        "snippet": {
          "type": "string",
          "maxLength": 65536
        },
        "site_name": {
          "type": "string",
          "maxLength": 65536
        },
        "date": {
          "type": "string",
          "maxLength": 65536
        },
        "authority": {
          "type": "string",
          "maxLength": 65536
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchChunk"
          }
        },
        "content_status": {
          "$ref": "#/$defs/ContentStatus"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content_status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "chunks": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "not": {
              "properties": {
                "chunks": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ContentSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "truncated",
        "dropped_results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/ContentResult"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "dropped_results": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "dropped_results": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "results": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "properties": {
                        "content_status": {
                          "const": "truncated"
                        }
                      },
                      "required": [
                        "content_status"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "truncated": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "ProSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "truncated",
        "dropped_results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/ProResult"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "dropped_results": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "dropped_results": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "results": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "properties": {
                        "content_status": {
                          "const": "truncated"
                        }
                      },
                      "required": [
                        "content_status"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "truncated": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "ProOutput": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/ProSuccess"
        },
        {
          "$ref": "#/$defs/ErrorOutput"
        }
      ]
    }
  }
}
