{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Yijie Events",
    "version": "0.1.0",
    "description": "Event contracts exchanged by Yijie services."
  },
  "channels": {
    "task.events": {
      "address": "task.events",
      "messages": {
        "taskEvent": {
          "payload": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agentSessionEvents": {
      "address": "agent.session.events",
      "description": "Sanitized Agent Host events. Consumers order and resume events by stream_id plus sequence and deduplicate at-least-once delivery by event_id.",
      "messages": {
        "agentSessionEvent": {
          "$ref": "#/components/messages/AgentSessionEvent"
        }
      }
    }
  },
  "operations": {
    "receiveTaskEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/task.events"
      },
      "messages": [
        {
          "$ref": "#/channels/task.events/messages/taskEvent"
        }
      ]
    },
    "receiveAgentSessionEvents": {
      "action": "receive",
      "description": "Receive one AgentSessionEvent at a time. A stream_id change starts a new ordering domain; it does not imply replay of events from an earlier Host process.",
      "channel": {
        "$ref": "#/channels/agentSessionEvents"
      },
      "messages": [
        {
          "$ref": "#/components/messages/AgentSessionEvent"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "AgentSessionEvent": {
        "name": "AgentSessionEvent",
        "title": "Ordered Agent Host session event",
        "summary": "At-least-once event ordered by sequence within a single stream_id.",
        "description": "JSON payload semantics are authoritative in the referenced JSON Schema. Protobuf message yijie.events.v1.AgentSessionEvent carries the equivalent service and asynchronous-consumer model.",
        "contentType": "application/json",
        "correlationId": {
          "description": "Agent Host session that owns the ordered event stream.",
          "location": "$message.payload#/agent_session_id"
        },
        "payload": {
          "$ref": "#/components/schemas/session-event.schema"
        }
      }
    },
