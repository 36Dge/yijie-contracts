      "properties": {
        "url": {
          "$ref": "#/$defs/PublicUrl"
        }
      },
      "$defs": {
        "PublicUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "uri",
          "pattern": "^https?://",
          "description": "Public HTTP(S) URL. Connector additionally parses authority, rejects userinfo/control characters and local/private literal destinations; no local request to this target is made."
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/FetchSuccess"
        },
        {
          "$ref": "#/$defs/ErrorOutput"
        }
      ],
      "$defs": {
        "FetchSuccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "title",
            "markdown",
            "truncated"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/PublicUrl"
            },
            "title": {
              "type": "string",
              "maxLength": 65536
            },
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "\\S"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        "PublicUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "uri",
          "pattern": "^https?://",
          "description": "Public HTTP(S) URL. Connector additionally parses authority, rejects userinfo/control characters and local/private literal destinations; no local request to this target is made."
        },
