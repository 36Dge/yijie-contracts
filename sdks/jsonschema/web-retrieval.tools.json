              "minLength": 1,
              "maxLength": 512
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_arguments"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "检索参数无效，请检查查询词、数量或网页地址。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
