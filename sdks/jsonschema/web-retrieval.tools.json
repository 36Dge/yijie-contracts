              },
              "then": {
                "properties": {
                  "message": {
                    "const": "本次网页检索已取消；已发送的请求可能计费。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          ]
        },
        "ErrorCode": {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "authentication_failed",
            "permission_denied",
            "rate_limited",
            "timeout",
            "unavailable",
            "no_content",
            "response_too_large",
            "invalid_response",
            "cancelled"
          ]
