[
  {
    "name": "kimi_web_search",
    "description": "用户只要网页标题、摘要和链接列表，未限定站点/日期且不要求问答或分析时，直接使用本Basic工具，不使用Pro。用于展示网页标题、摘要、链接列表或找官网，默认include_content=false；用户明确采集正文供自行加工时才用true。选中本连接器的普通联网问答、事实核查、研究或总结直接用kimi_web_search_pro，不先Basic试探，也不为同一信息需求重复原生搜索。不能使用站点/日期过滤；明确只用Basic却要求过滤时说明冲突。只读按次计费，单次批准，不自动重试。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "include_content": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/SearchSuccess"
        },
        {
          "$ref": "#/$defs/ContentSuccess"
        },
        {
          "$ref": "#/$defs/ErrorOutput"
        }
      ],
      "$defs": {
        "SearchSuccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "results",
            "truncated"
          ],
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/SearchResult"
              }
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        "SearchResult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "url",
            "snippet"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 65536
            },
            "url": {
              "$ref": "#/$defs/PublicUrl"
            },
            "snippet": {
              "type": "string",
              "maxLength": 65536
            }
          }
        },
        "PublicUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "uri",
          "pattern": "^https?://",
          "description": "Public HTTP(S) URL. Connector additionally parses authority, rejects userinfo/control characters and local/private literal destinations; no local request to this target is made."
        },
        "ContentSuccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "results",
            "truncated",
            "dropped_results"
          ],
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/ContentResult"
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "dropped_results": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "properties": {
                      "dropped_results": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "results": {
                        "type": "array",
                        "contains": {
                          "type": "object",
                          "properties": {
                            "content_status": {
                              "const": "truncated"
                            }
                          },
                          "required": [
                            "content_status"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "then": {
                "properties": {
                  "truncated": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
        "ContentResult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "url",
            "snippet",
            "text",
            "content_status"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 65536
            },
            "url": {
              "$ref": "#/$defs/PublicUrl"
            },
            "snippet": {
              "type": "string",
              "maxLength": 65536
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "content_status": {
              "$ref": "#/$defs/ContentStatus"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "content_status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "text": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "content_status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "not": {
                  "properties": {
                    "text": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          ]
        },
        "ContentStatus": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "truncated"
          ]
        },
        "ErrorOutput": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "$ref": "#/$defs/ToolError"
            }
          }
        },
        "ToolError": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_arguments"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "检索参数无效，请检查查询词、数量或网页地址。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "authentication_failed"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "Kimi API Key 无效或已失效，请重新配置。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "permission_denied"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "服务拒绝了此请求，请检查账户权限或目标网页是否允许读取。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "rate_limited"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "Kimi 请求频率或并发受限，请确认后重新发起调用。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "timeout"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "本次网页检索超时，未自动重试；已发送的请求可能计费。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "unavailable"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "网页检索服务暂不可用，未自动重试。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "no_content"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "目标网页未返回可读取的正文。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "response_too_large"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "网页检索结果超过可处理的大小限制。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_response"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "网页检索服务返回了无法验证的结果。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "cancelled"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "本次网页检索已取消；已发送的请求可能计费。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          ]
        },
        "ErrorCode": {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "authentication_failed",
            "permission_denied",
            "rate_limited",
            "timeout",
            "unavailable",
            "no_content",
            "response_too_large",
            "invalid_response",
            "cancelled"
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "kimi_web_search_pro",
    "description": "先区分交付物：仅列网页标题、摘要、链接列表、未限定站点/日期且不做问答或分析的任务，不使用本工具，只使用kimi_web_search（Basic摘要）。除此之外，选中本连接器时，普通联网问答、事实核查、研究、总结和RAG材料直接使用Pro，即使没有站点或时间过滤；不要先Basic或并行原生搜索。仅按用户明确要求设置sites(最多5，OR)及time_window；不得擅自增加过滤。返回关联真实URL的正文chunks，缺正文或截断须说明，score仅同次查询相对相关性。仅在还需某页当前正文时对结果URL另提Fetch，不声称历史快照。只读按次计费，单次批准，失败不自动重试/换接口。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "sites": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\s()]+$"
          }
        },
        "time_window": {
          "$ref": "#/$defs/TimeWindow"
        }
      },
      "$defs": {
        "TimeWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "start": {
              "$ref": "#/$defs/DateBound"
            },
            "end": {
              "$ref": "#/$defs/DateBound"
            }
          }
        },
        "DateBound": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!0000)[0-9]{4}$"
            },
            {
              "type": "string",
              "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/ProSuccess"
        },
        {
          "$ref": "#/$defs/ErrorOutput"
        }
      ],
      "$defs": {
        "ProSuccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "results",
            "truncated",
            "dropped_results"
          ],
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/ProResult"
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "dropped_results": {
              "type": "integer",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {
                    "properties": {
                      "dropped_results": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "results": {
                        "type": "array",
                        "contains": {
                          "type": "object",
                          "properties": {
                            "content_status": {
                              "const": "truncated"
                            }
                          },
                          "required": [
                            "content_status"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "then": {
                "properties": {
                  "truncated": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
        "ProResult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "url",
            "snippet",
            "site_name",
            "date",
            "authority",
            "chunks",
            "content_status"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 65536
            },
            "url": {
              "$ref": "#/$defs/PublicUrl"
            },
            "snippet": {
              "type": "string",
              "maxLength": 65536
            },
            "site_name": {
              "type": "string",
              "maxLength": 65536
            },
            "date": {
              "type": "string",
              "maxLength": 65536
            },
            "authority": {
              "type": "string",
              "maxLength": 65536
            },
            "chunks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SearchChunk"
              }
            },
            "content_status": {
              "$ref": "#/$defs/ContentStatus"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "content_status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "chunks": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "content_status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "not": {
                  "properties": {
                    "chunks": {
                      "type": "array",
                      "contains": {
                        "type": "object",
                        "required": [
                          "text"
                        ],
                        "properties": {
                          "text": {
                            "type": "string",
                            "pattern": "\\S"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "PublicUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "uri",
          "pattern": "^https?://",
          "description": "Public HTTP(S) URL. Connector additionally parses authority, rejects userinfo/control characters and local/private literal destinations; no local request to this target is made."
        },
        "SearchChunk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "score"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "score": {
              "$ref": "#/$defs/ChunkScore"
            }
          }
        },
        "ChunkScore": {
          "type": "number",
          "description": "Finite query-relative score. No cross-query trust threshold."
        },
        "ContentStatus": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "truncated"
          ]
        },
        "ErrorOutput": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "$ref": "#/$defs/ToolError"
            }
          }
        },
        "ToolError": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_arguments"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "检索参数无效，请检查查询词、数量或网页地址。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "authentication_failed"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "Kimi API Key 无效或已失效，请重新配置。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "permission_denied"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "服务拒绝了此请求，请检查账户权限或目标网页是否允许读取。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "rate_limited"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "Kimi 请求频率或并发受限，请确认后重新发起调用。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "timeout"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "本次网页检索超时，未自动重试；已发送的请求可能计费。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "unavailable"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "网页检索服务暂不可用，未自动重试。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "no_content"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "目标网页未返回可读取的正文。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "response_too_large"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "网页检索结果超过可处理的大小限制。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_response"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "网页检索服务返回了无法验证的结果。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "cancelled"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "message": {
                    "const": "本次网页检索已取消；已发送的请求可能计费。"
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          ]
        },
        "ErrorCode": {
